# ==============================================================================
# Face Verification Attendance System - Environment Variables Template
# Copy this file to '.env' and populate with your production credentials and paths.
# DO NOT commit '.env' to version control.
# ==============================================================================

# --- Application Security & Credentials ---
# Administrator credentials (required; no hardcoded default fallback)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Campus kiosk terminal credentials (required; no hardcoded default fallback)
KIOSK_USERNAME=kiosk
KIOSK_PASSWORD=your_secure_kiosk_password_here

# Inactivity session timeout (in minutes). After this idle period, sessions are automatically logged out.
SESSION_TIMEOUT_MINUTES=30

# Controls visibility of evaluation credentials on the login screen.
# Set to 'false' in production deployments.
SHOW_EVAL_CREDENTIALS=false

# --- SSL / TLS Encryption Settings ---
# Paths to local SSL/TLS certificate and private key (generated by scripts/generate_ssl_certs.py)
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# --- Streamlit Web Server Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# --- Biometric Face Engine Calibrations ---
# ArcFace 512-D Cosine Similarity Decision Threshold (default: 0.58)
VERIFICATION_THRESHOLD=0.58

# Minimum margin between top-1 and top-2 candidate similarity scores (default: 0.05)
MIN_MARGIN=0.05

# Number of consecutive matching frames required to verify attendance (default: 3)
CONSECUTIVE_FRAMES=3

# Camera hardware device index (0 = default webcam, 1/2 = external or Iriun webcam)
WEBCAM_INDEX=0
